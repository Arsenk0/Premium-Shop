#: store/telegram_bot/messages.py:9
msgid ""
"👋 Вітаємо в боті <b>Premium Shop</b>!\n"
"\n"
"Тут ви можете:\n"
"📦 Переглядати свої замовлення\n"
"🔔 Отримувати сповіщення про зміну статусів\n"
"🎁 Керувати бонусними балами\n"
"\n"
"Щоб почати — прив'яжіть свій акаунт на сайті.\n"
"Натисніть кнопку нижче та введіть отриманий код:"
msgstr ""
"👋 Welcome to the <b>Premium Shop</b> bot!\n"
"\n"
"Here you can:\n"
"📦 View your orders\n"
"🔔 Receive notifications about status changes\n"
"🎁 Manage bonus points\n"
"\n"
"To get started, link your account on our website.\n"
"Click the button below and enter the code you received:"

#: store/telegram_bot/messages.py:19
#, python-brace-format
msgid ""
"👋 З поверненням, <b>{username}</b>!\n"
"\n"
"Ваш акаунт прив'язано ✅\n"
"\n"
"Доступні команди:\n"
"/orders — мої замовлення\n"
"/loyalty — бонусні бали\n"
"/promo — отримати промокод\n"
"/help — допомога"
msgstr ""
"👋 Welcome back, <b>{username}</b>!\n"
"\n"
"Your account is linked ✅\n"
"\n"
"Available commands:\n"
"/orders — my orders\n"
"/loyalty — bonus points\n"
"/promo — get a promo code\n"
"/help — help"

#: store/telegram_bot/messages.py:29
msgid ""
"🛍 <b>Premium Shop Bot — Команди</b>\n"
"\n"
"/orders — переглянути останні замовлення\n"
"/order <i>ID</i> — деталі замовлення\n"
"/loyalty — баланс балів і тир\n"
"/promo — згенерувати промокод за бали\n"
"/unlink — від'єднати Telegram-акаунт\n"
"/help — ця довідка\n"
"\n"
"💬 <i>Потрібна допомога? Напишіть нам на сайті.</i>"
msgstr ""
"🛍 <b>Premium Shop Bot — Commands</b>\n"
"\n"
"/orders — view recent orders\n"
"/order <i>ID</i> — order details\n"
"/loyalty — points balance and tier\n"
"/promo — generate a promo code for points\n"
"/unlink — unlink Telegram account\n"
"/help — this help guide\n"
"\n"
"💬 <i>Need help? Contact us on the website.</i>"

#: store/telegram_bot/messages.py:40
msgid ""
"❌ Ваш Telegram не прив'язаний до жодного акаунта.\n"
"\n"
"Зайдіть на сайт → Кабінет → Telegram і отримайте код."
msgstr ""
"❌ Your Telegram is not linked to any account.\n"
"\n"
"Go to the website → Profile → Telegram and get a code."

#: store/telegram_bot/messages.py:46
msgid ""
"🔐 Введіть 6-значний код, який ви отримали на сайті\n"
"у розділі <b>Кабінет → Telegram</b>:"
msgstr ""
"🔐 Enter the 6-digit code you received on the website\n"
"in the <b>Profile → Telegram</b> section:"

#: store/telegram_bot/messages.py:51
#, python-brace-format
msgid ""
"✅ <b>Акаунт успішно прив'язано!</b>\n"
"\n"
"Вітаємо, <b>{username}</b>! 🎉\n"
"Тепер ви будете отримувати сповіщення про ваші замовлення прямо тут.\n"
"\n"
"/help — список команд"
msgstr ""
"✅ <b>Account successfully linked!</b>\n"
"\n"
"Welcome, <b>{username}</b>! 🎉\n"
"You will now receive notifications about your orders right here.\n"
"\n"
"/help — list of commands"

#: store/telegram_bot/messages.py:58
msgid ""
"❌ Невірний або застарілий код. Спробуйте ще раз.\n"
"\n"
"Отримайте новий код на сайті у розділі <b>Кабінет → Telegram</b>."
msgstr ""
"❌ Invalid or expired code. Please try again.\n"
"\n"
"Get a new code on the website in the <b>Profile → Telegram</b> section."

#: store/telegram_bot/messages.py:63
#, python-brace-format
msgid ""
"ℹ️ Ваш Telegram вже прив'язано до акаунта <b>{username}</b>.\n"
"\n"
"Щоб від'єднати — використайте /unlink"
msgstr ""
"ℹ️ Your Telegram is already linked to account <b>{username}</b>.\n"
"\n"
"To unlink, use /unlink"

#: store/telegram_bot/messages.py:68
#, python-brace-format
msgid ""
"⚠️ Ви впевнені, що хочете від'єднати Telegram від акаунта <b>{username}</b>?\n"
"\n"
"Ви більше не будете отримувати сповіщення про замовлення."
msgstr ""
"⚠️ Are you sure you want to unlink Telegram from account <b>{username}</b>?\n"
"\n"
"You will no longer receive order notifications."

#: store/telegram_bot/messages.py:72
msgid "✅ Акаунт від'єднано. Щоб прив'язати знову — зайдіть на сайт."
msgstr "✅ Account unlinked. To link again, go to the website."

#: store/telegram_bot/messages.py:73
msgid "↩️ Від'єднання скасовано."
msgstr "↩️ Unlinking cancelled."

